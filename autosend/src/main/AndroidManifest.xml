<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Управлять службой (взвести/отменить нажатие) могут только приложения,
         подписанные тем же ключом, что и это приложение (CRM). -->
    <permission
        android:name="com.rykov.autosend.permission.CONTROL"
        android:label="@string/permission_control_label"
        android:description="@string/permission_control_description"
        android:protectionLevel="signature" />

    <!-- Нужно самому приложению для экрана «Проверка»: он шлёт команду так же, как CRM. -->
    <uses-permission android:name="com.rykov.autosend.permission.CONTROL" />

    <!-- Android 11+: экран «Проверка» открывает чат WhatsApp. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- INTERNET намеренно не запрашивается: приложение физически не может ничего передать в сеть. -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_send"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".services.AutoSendAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Команды от CRM. Отправитель обязан иметь разрешение CONTROL. -->
        <receiver
            android:name=".receivers.CommandReceiver"
            android:permission="com.rykov.autosend.permission.CONTROL"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rykov.autosend.action.ARM_SEND" />
                <action android:name="com.rykov.autosend.action.CANCEL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
